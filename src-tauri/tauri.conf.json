{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atenea",
  "version": "0.2.3",
  "identifier": "com.maeck.biblioteca-ia",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Atenea",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0Qzg1ODMyQTU2RjIxRDQKUldUVUlXK2xNbGpJeEdQUlQ2SFVzUjdkQ3paUVlMZmVpZWVVeDFrOGZ1U3BZMDF0dGlyRVQwY2UK",
      "endpoints": [
        "https://github.com/My3130/Atenea/releases/latest/download/latest.json"
      ]
    }
  }
}